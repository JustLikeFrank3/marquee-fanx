MARQUEE_DATA_MODE=sample
SEATGEEK_CLIENT_ID=
# Optional; only if your API access requires it.
SEATGEEK_CLIENT_SECRET=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# In-page AI planner (server only; never use a VITE_ prefix)
OPENAI_API_KEY=
OPENAI_MODEL=

# Dedicated Azure Foundry agent (alternative to OpenAI above)
MARQUEE_AI_PROVIDER=azure_foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=marquee-planner
# Local development uses az login; deployed app uses managed_identity.
FOUNDRY_AUTH=azure_cli

# Local model with cloud fallback: set MARQUEE_AI_PROVIDER=local_first and point at any
# OpenAI-compatible server (Ollama: http://127.0.0.1:11434/v1, LM Studio: http://127.0.0.1:1234/v1).
# When the local server is unreachable, chat falls back to the Foundry agent above.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# Optional; only if your local server requires a key.
LOCAL_LLM_API_KEY=

# Server-only credential for Marquee's dedicated Azure Maps account
AZURE_MAPS_KEY=

# Last.fm API key for related-artist discovery and tag-affinity ranking (server only)
LASTFM_API_KEY=
